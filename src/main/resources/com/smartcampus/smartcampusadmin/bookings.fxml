<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartcampus.smartcampusadmin.controller.BookingsController">

    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>

            <Label text="Bookings" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Utilization" onAction="#handleGoToUtilization" />
            <Button text="Resources" onAction="#handleGoToResources" />
            <Button text="Logout" onAction="#handleLogout" />
        </HBox>
    </top>

    <center>
        <TableView fx:id="bookingsTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0" />
                <TableColumn fx:id="resourceIdColumn" text="Resource ID" prefWidth="90.0" />
                <TableColumn fx:id="userIdColumn" text="User ID" prefWidth="70.0" />
                <TableColumn fx:id="startTimeColumn" text="Start" prefWidth="150.0" />
                <TableColumn fx:id="endTimeColumn" text="End" prefWidth="150.0" />
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="100.0" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>

            <Label text="Filter by status:" />
            <ComboBox fx:id="statusFilterBox" />

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Approve selected" onAction="#handleApprove" />
            <Button text="Reject selected" onAction="#handleReject" />
        </HBox>
    </bottom>

</BorderPane>