<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smartcampus.smartcampusadmin.controller.ResourcesController">

    <top>
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>

            <Label text="Resources" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <Region HBox.hgrow="ALWAYS" />

            <Button text="Bookings" onAction="#handleGoToBookings" />
            <Button text="Utilization" onAction="#handleGoToUtilization" />
            <Button text="Logout" onAction="#handleLogout" />
        </HBox>
    </top>

    <center>
        <TableView fx:id="resourcesTable">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0" />
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="150.0" />
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="100.0" />
                <TableColumn fx:id="capacityColumn" text="Capacity" prefWidth="80.0" />
                <TableColumn fx:id="departmentColumn" text="Department" prefWidth="120.0" />
                <TableColumn fx:id="locationColumn" text="Location" prefWidth="120.0" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10.0">
            <padding>
                <Insets top="10.0" right="10.0" bottom="10.0" left="10.0" />
            </padding>

            <GridPane hgap="10.0" vgap="8.0">
                <TextField fx:id="nameField" promptText="Name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="typeField" promptText="Type (room/lab/equipment/compute_slot)" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <TextField fx:id="capacityField" promptText="Capacity" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="departmentField" promptText="Department" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="locationField" promptText="Location" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>

            <HBox spacing="10.0">
                <Button text="Add New" onAction="#handleAdd" />
                <Button text="Update Selected" onAction="#handleUpdate" />
                <Button text="Delete Selected" onAction="#handleDelete" />
                <Label fx:id="errorLabel" style="-fx-text-fill: #bc002d;" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>