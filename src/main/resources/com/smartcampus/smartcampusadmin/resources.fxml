<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.smartcampus.smartcampusadmin.controller.ResourcesController"
           styleClass="dashboard-plain-background">

    <BorderPane>
        <top>
            <HBox alignment="CENTER_LEFT">
                <padding>
                    <Insets top="20.0" right="24.0" bottom="10.0" left="24.0" />
                </padding>
                <Label text="Resources" styleClass="dashboard-heading" />
            </HBox>
        </top>

        <center>
            <VBox styleClass="dashboard-panel" spacing="12.0">
                <BorderPane.margin>
                    <Insets top="0.0" right="24.0" bottom="24.0" left="24.0" />
                </BorderPane.margin>

                <TableView fx:id="resourcesTable">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="50.0" />
                        <TableColumn fx:id="nameColumn" text="Name" prefWidth="150.0" />
                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="100.0" />
                        <TableColumn fx:id="capacityColumn" text="Capacity" prefWidth="80.0" />
                        <TableColumn fx:id="departmentColumn" text="Department" prefWidth="120.0" />
                        <TableColumn fx:id="locationColumn" text="Location" prefWidth="120.0" />
                    </columns>
                </TableView>

                <GridPane hgap="10.0" vgap="8.0">
                    <TextField fx:id="nameField" promptText="Name" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="typeField" promptText="Type (room/lab/equipment/compute_slot)" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <TextField fx:id="capacityField" promptText="Capacity" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="departmentField" promptText="Department" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="locationField" promptText="Location" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                </GridPane>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Button text="Add New" onAction="#handleAdd" />
                    <Button text="Update Selected" onAction="#handleUpdate" />
                    <Button text="Delete Selected" styleClass="secondary-button" onAction="#handleDelete" />
                    <Label fx:id="errorLabel" styleClass="error-text" />
                </HBox>
            </VBox>
        </center>
    </BorderPane>

    <VBox fx:id="sidebarPanel" styleClass="sidebar-overlay" visible="false" managed="false"
          prefWidth="220.0" maxWidth="220.0"
          StackPane.alignment="CENTER_LEFT">
        <Button text="Bookings" styleClass="sidebar-button" maxWidth="Infinity" onAction="#handleGoToBookings" />
        <Button text="Resources" styleClass="sidebar-button-active" maxWidth="Infinity" onAction="#handleGoToResources" />
        <Button text="Utilization" styleClass="sidebar-button" maxWidth="Infinity" onAction="#handleGoToUtilization" />

        <Region VBox.vgrow="ALWAYS" />

        <Button text="Logout" styleClass="sidebar-button" maxWidth="Infinity" onAction="#handleLogout" />
    </VBox>

    <Button fx:id="avatarButton" styleClass="avatar-button" onAction="#handleToggleSidebar"
            StackPane.alignment="BOTTOM_LEFT">
        <StackPane.margin>
            <Insets bottom="16.0" left="16.0" />
        </StackPane.margin>
    </Button>

</StackPane>